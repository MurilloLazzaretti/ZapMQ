<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{64404FAF-17B6-451F-BD0A-3901256BBB16}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="ZapMQ.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Z:\prod\ZapMQ\standalone\StandAlone.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="ZapMQ">
        <MSBuild Projects="ZapMQ.dproj"/>
    </Target>
    <Target Name="ZapMQ:Clean">
        <MSBuild Projects="ZapMQ.dproj" Targets="Clean"/>
    </Target>
    <Target Name="ZapMQ:Make">
        <MSBuild Projects="ZapMQ.dproj" Targets="Make"/>
    </Target>
    <Target Name="StandAlone">
        <MSBuild Projects="Z:\prod\ZapMQ\standalone\StandAlone.dproj"/>
