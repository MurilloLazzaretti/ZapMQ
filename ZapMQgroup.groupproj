    <Target Name="StandAlone:Make">
        <MSBuild Projects="Z:\prod\ZapMQ\standalone\StandAlone.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="ZapMQ;StandAlone"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="ZapMQ:Clean;StandAlone:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="ZapMQ:Make;StandAlone:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
